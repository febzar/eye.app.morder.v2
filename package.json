{
  "name": "morderx",
  "version": "1.0.0",
  "description": "Morderx Desktop Application - Screen Share & Control via Local Network",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "start:host": "electron . --mode=host",
    "start:client": "electron . --mode=client",
    "dev": "electron . --dev",
    "serve": "node server.js",
    "serve:bg": "node scripts/serve.js start",
    "serve:stop": "node scripts/serve.js stop",
    "serve:log": "node scripts/serve.js log",
    "serve:status": "node scripts/serve.js status",
    "serve:auto": "electron . --auto-host --no-open",
    "serve:auto:bg": "node scripts/serve.js auto",
    "pm2:start": "pm2 start server.js --name morderx",
    "pm2:stop": "pm2 stop morderx",
    "pm2:restart": "pm2 restart morderx",
    "pm2:logs": "pm2 logs morderx",
    "pm2:status": "pm2 status",
    "host": "node src/host-cli.js",
    "client": "node src/client-cli.js",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "keywords": [
    "morderx",
    "desktop",
    "screen-share",
    "local-network"
  ],
  "author": "Morderx",
  "license": "MIT",
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.15.0"
  },
  "dependencies": {
    "@jitsi/robotjs": "^0.6.22",
    "bonjour-service": "^1.2.1",
    "jimp": "^0.22.12",
    "node-fetch": "^2.7.0",
    "screenshot-desktop": "^1.15.4",
    "uuid": "^9.0.1",
    "ws": "^8.20.0"
  },
  "build": {
    "appId": "com.morderx.desktop",
    "productName": "Morderx",
    "fileAssociations": [
      {
        "ext": "remapp",
        "name": "Morderx Connection File",
        "description": "Morderx Connection File",
        "icon": "assets/icons/file-icon",
        "role": "Viewer"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icons/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icons/icon.icns",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icons/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ]
  }
}
